<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Used by the "archive-adhoc" CI job (alternative release path —
	     see RELEASE.md). Produces a raw, sideloadable .ipa instead of a
	     TestFlight upload; requires device UDIDs to be registered in the
	     matching provisioning profile. -->
	<key>method</key>
	<string>ad-hoc</string>
	<key>teamID</key>
	<string>REPLACE_WITH_YOUR_TEAM_ID</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>compileBitcode</key>
	<false/>
</dict>
</plist>
