# Generated by XcodeGen on every build — never commit
*.xcodeproj
*.xcworkspace

# CocoaPods — restored by `pod install` in CI
Pods/

# Xcode
DerivedData/
xcuserdata/
*.xcuserstate

# whisper model — downloaded fresh by CI (or track with Git LFS if preferred)
PrivateMediaStudio/Resources/Models/*.bin

# Signing material from the RELEASE.md walkthrough — these are real secrets
# (private key, distribution cert, provisioning profile, App Store Connect
# API key) generated locally on your machine, never meant to be committed.
# CI gets them from GitHub Secrets instead — see RELEASE.md.
*.p12
*.p12.b64
*.key
*.csr
*.cer
*.pem
*.mobileprovision
*.mobileprovision.b64
profile.b64
AuthKey_*.p8
apikey.b64

# macOS
.DS_Store
